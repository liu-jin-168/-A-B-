        'chi2统计量': round(chi2_stat, 4),
        'p值': round(p_value, 4),
        '自由度': dof,
        '显著性': significance
    }

    # 输出结果
    print(f"\n【{metric}（转化率）】")
    print(f"  检验方法: 卡方检验")
