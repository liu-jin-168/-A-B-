# 3.4 效应量计算（Cohen's d）- 评估差异的实际意义

# 定义Cohen's d计算函数
def cohens_d(group1, group2):
    n1, n2 = len(group1), len(group2)
    var1, var2 = group1.var(), group2.var()

    # 合并标准差
    pooled_std = np.sqrt(((n1 - 1) * var1 + (n2 - 1) * var2) / (n1 + n2 - 2))

    # 均值差异
    mean_diff = group2.mean() - group1.mean()

    # Cohen's d
    d = mean_diff / pooled_std

    return d

# 效应量解释标准
effect_size_interpretation = {
    '微小': (-0.2, 0.2),
    '小': (-0.5, -0.2) + (0.2, 0.5),
    '中': (-0.8, -0.5) + (0.5, 0.8),
    '大': (-float('inf'), -0.8) + (0.8, float('inf'))
}

def interpret_effect_size(d):
    """解释效应量大小"""
    d_abs = abs(d)
    if d_abs < 0.2:
        return "微小"
    elif d_abs < 0.5:
        return "小"
    elif d_abs < 0.8:
        return "中"
    else:
        return "大"

# 计算连续型指标的效应量

for metric in continuous_metrics:
    group1 = light_theme_data[metric].dropna()
    group2 = dark_theme_data[metric].dropna()

    d = cohens_d(group1, group2)
    effect_size = interpret_effect_size(d)

    # 更新检验结果
    test_results[metric]['效应量(Cohen\'s d)'] = round(d, 4)
    test_results[metric]['效应量大小'] = effect_size

    # 输出结果
    print(f"\n【{metric}】")
    print(f"  Cohen's d: {d:.4f}")
    print(f"  效应量大小: {effect_size}")

    # 结合显著性和效应量给出综合结论
    sig = test_results[metric]['显著性']
    if sig == "显著" and effect_size in ["中", "大"]:
        conclusion = "✅ 差异具有统计显著性且实际业务意义较大"
